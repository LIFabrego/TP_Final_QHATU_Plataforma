--- !u!114 &847290241
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 847290238}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 64d4c6c1efb0f654ea1f455cf12c0ec3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  preguntas:
  - texto: "\xBFQUE DEBO HACER DURANTE LA PELICULA?"
    opciones:
    - HABLAR FUERTE
    - MIRAR EN SILENCIO
    - GRITAR A LOS PERSONAJES
    pictogramasOpciones:
    - {fileID: 21300000, guid: 92f1f87bb85af44499d32fd442625f02, type: 3}
    - {fileID: 21300000, guid: 1ead9aeb917dc8c4fafd33495a75e75f, type: 3}
    - {fileID: 21300000, guid: 4b825f529db9f2e47ac31e2a1c04599e, type: 3}
    respuestaCorrecta: 1
    respuestasParciales: 
    audioNarracion: {fileID: 8300000, guid: 490ed5cd94f2ff541861a13a1ef5410b, type: 3}
    textoAyuda: PARA DISFRUTAR, TODOS NECESITAN SILENCIO.
    audioAyuda: {fileID: 8300000, guid: 068809db39c45cb4bab15974cb0e4a04, type: 3}
  - texto: "\xBFQUE DEBO HACER CON MI CELULAR DURANTE LA FUNCION?"
    opciones:
    - JUGAR CON EL EN VOZ ALTA
    - DEJARLO SONANDO
    - APAGARLO O SILENCIARLO
    pictogramasOpciones:
    - {fileID: 21300000, guid: 3010817f49a441e47813a98c3399644a, type: 3}
    - {fileID: 21300000, guid: 77527176567ec6646a9abab20f6ad981, type: 3}
    - {fileID: 21300000, guid: 5a3b4e244276ec548a08a0f940b2088f, type: 3}
    respuestaCorrecta: 2
    respuestasParciales: 
    audioNarracion: {fileID: 8300000, guid: 1cf3a2213cb61cc4aa775853ec2da495, type: 3}
    textoAyuda: EL CELULAR NO DEBE MOLESTAR A OTRAS PERSONAS QUE VERAN LA FUNCION
    audioAyuda: {fileID: 8300000, guid: cfafeadb973187e41805ec5c72bb54a7, type: 3}
  - texto: "\xBFQUE DEBO HACER SI NECESITO SALIR DURANTE LA PELICULA?"
    opciones:
    - PASAR EN SILENCIO
    - EMPUJAR LAS SILLAS
    - "GRITAR \xA1PERMISO!"
    pictogramasOpciones:
    - {fileID: 21300000, guid: 1ead9aeb917dc8c4fafd33495a75e75f, type: 3}
    - {fileID: 21300000, guid: e0b512e63846f45489e2671402ebc8a6, type: 3}
    - {fileID: 21300000, guid: 4b825f529db9f2e47ac31e2a1c04599e, type: 3}
    respuestaCorrecta: 0
    respuestasParciales: 
    audioNarracion: {fileID: 8300000, guid: 0fcfd5b3ea5e0b245b7c4213d5af16c5, type: 3}
    textoAyuda: DEBEMOS MOVERNOS DE FORMA TRANQUILA Y RESPETUOSA
    audioAyuda: {fileID: 8300000, guid: ef56c6ccbe712c24394a4db731d87578, type: 3}
