    textoAyuda: TOMAS, CUANDO PEDIMOS ALGO, USAMOS BUENOS MODALES
    audioAyuda: {fileID: 8300000, guid: 4bcfb701292a2fb4a816811de2aedcb0, type: 3}
  - texto: "\xBFCON QUE PAGO LA ENTRADA?"
    opciones:
    - UN JUGUETE
    - DINERO
    - GOLOSINAS
    pictogramasOpciones:
    - {fileID: 21300000, guid: 699922a49bf1f214a9666ce3530118fa, type: 3}
