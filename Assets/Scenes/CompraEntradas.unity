    pictogramasOpciones:
    - {fileID: -1404573905, guid: 4cbfcb8c8830e304394c6b127c485b57, type: 3}
    - {fileID: 21300000, guid: f02bbbd44d67d5541b67cfa5d8b87f81, type: 3}
    - {fileID: 21300000, guid: 52fb48ecbb174a54d9a09a290b5a249a, type: 3}
    respuestaCorrecta: 0
    respuestasParciales: 
    audioNarracion: {fileID: 8300000, guid: 1aa928b53d40efd43967f691d274bf4a, type: 3}
    textoAyuda: LO QUE SE NECESITA PARA ENTRAR A VER LA PELICULA
    audioAyuda: {fileID: 8300000, guid: be53065e44a1c9c48ad62f3e0c027af9, type: 3}
  - texto: "\xBFCOMO DEBO HABLAR CON EL CAJERO?"
    opciones:
