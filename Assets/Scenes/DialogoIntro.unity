--- !u!114 &2138058393
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2138058392}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 327242635dfe18c4ba3b030f8f209477, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - speaker: MAMA
    text: "\xA1BUENOS DIAS TOMAS! HOY ES UN GRAN DIA. \xBFESTAS LISTO PARA LA AVENTURA?"
    voiceClip: {fileID: 8300000, guid: d500fd5cc64fd6941b8b913111a4f041, type: 3}
  - speaker: TOMAS
    text: "\xA1SI, MAMA! \xA1ESTOY MUY EMOCIONADO!"
    voiceClip: {fileID: 8300000, guid: a272c558f5b2b6842a9ce9d965e69d74, type: 3}
  - speaker: MAMA
    text: ME ALEGRA, HIJO. RECUERDA QUE EN EL CINE HAY QUE ESTAR TRANQUILO, ESCUCHAR
      Y RESPETAR A LOS DEMAS.
    voiceClip: {fileID: 8300000, guid: 8ceab0627764202489d8ce33db83b9c1, type: 3}
  - speaker: TOMAS
    text: LO SE, NO DEBO GRITAR NI PARARME EN EL ASIENTO
    voiceClip: {fileID: 8300000, guid: 7b54e7282296cce42ab07575017803b0, type: 3}
  - speaker: MAMA
    text: MUY BIEN. TAMBIEN, EN EL CAMINO, TOMARAS ALGUNAS DECISIONES IMPORTANTES.
      PERO TRANQUILO YO SE QUE TU PUEDES HACERLO.
    voiceClip: {fileID: 8300000, guid: 95dfa34f4a564234aad212cee1cebcdb, type: 3}
  - speaker: TOMAS
    text: "\xA1SI! YO PUEDO DECIDIR BIEN. ESTOY LISTO PARA LA AVENTURA."
    voiceClip: {fileID: 8300000, guid: 5824c26ace7f4ef40a2e59a46e743dcf, type: 3}
  - speaker: MAMA
    text: "ESO ME GUSTA. \xA1VAMOS CAMPEON! TU PUEDES HACERLO"
    voiceClip: {fileID: 8300000, guid: 0899fb67553496841b564791ae7660be, type: 3}
  dialogueText: {fileID: 753371607}
  speakerNameText: {fileID: 1627451089}
