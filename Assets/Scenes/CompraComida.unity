    textoAyuda: LO USAMOS PARA COMPRAR COSAS EN NEGOCIOS
    audioAyuda: {fileID: 8300000, guid: 1acf5a60b70bd774385710a01c731984, type: 3}
  - texto: "\xBFQUE DEBO HACER SI EL PERSONAL ME DA MAL EL PEDIDO?"
